# Public hub hostname (must match Caddyfile's site address)
HUB_DOMAIN=hub.mdrrmo.gov.ph

# Dashboard host serving JWKS + audit-batch endpoint
DASHBOARD_HOST=mdrrmo.gov.ph

# Email for ACME registration (Caddy → Let's Encrypt)
ACME_EMAIL=ops@mdrrmo.gov.ph

# Audit-shim batch endpoint (will be live in Phase 6 — separate spec)
# Leave blank during Phase 1-5; shim runs in dry-run mode logging to stdout.
AUDIT_BATCH_URL=

# Audit-shim auth (Phase 6)
AUDIT_BATCH_TOKEN=

# Slack/Discord webhook for hub-self-monitoring alerts (Phase 7)
ALERT_WEBHOOK_URL=

# Pinned versions
MEDIAMTX_VERSION=v1.6.0
CADDY_VERSION=2.8.4

# Caddy build profile (Path A vs Path B). Decided in Phase 0.7 spike.
# Selects which caddy/Dockerfile.<profile> to build and which image tag to use.
# - path-a → Caddy with caddy-jwt plugin (built via xcaddy in caddy/Dockerfile.path-a)
# - path-b → Caddy stock + auth-shim sidecar handles HLS/WebRTC/WHIP auth
# Note: auth-shim runs on BOTH profiles because RTSPS publish auth on 8443
# is always enforced via MediaMTX externalAuthenticationURL → auth-shim.
# WARNING: Do NOT rename this to COMPOSE_PROFILES — that name is reserved by
# Docker Compose and controls `profiles:` service activation, not build args.
CADDY_PROFILE=path-b

# terraform/oracle/terraform.tfvars.example
tenancy_ocid        = "ocid1.tenancy.oc1..REPLACE"
user_ocid           = "ocid1.user.oc1..REPLACE"
api_key_fingerprint = "aa:bb:cc:..."
api_key_path        = "~/.oci/oci_api_key.pem"
compartment_ocid    = "ocid1.compartment.oc1..REPLACE"
region              = "ap-singapore-1"
availability_domain = "REPLACE"          # `oci iam availability-domain list`
ops_public_key_path = "~/.ssh/mdrrmo_cctv_hub_ops_ed25519.pub"
ops_bastion_cidr    = "1.2.3.4/32"
cloudflare_token    = "REPLACE"
cloudflare_zone_id  = "REPLACE"
hub_subdomain       = "hub"
